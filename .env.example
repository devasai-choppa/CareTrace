# CareTrace configuration. Copy to .env. Never commit secrets.

DATA_DIR=data
WAREHOUSE=duckdb
DUCKDB_PATH=data/caretrace.duckdb

# groq | anthropic | openai | mock
LLM_PROVIDER=mock
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

NPPES_API_BASE=https://npiregistry.cms.hhs.gov/api/
DEMO_MODE=true
LOG_LEVEL=INFO

# Optional cloud warehouse (not used when WAREHOUSE=duckdb)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=CARETRACE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=caretrace

# API
API_HOST=0.0.0.0
API_PORT=8000
CARETRACE_API_URL=http://localhost:8000
MAX_UPLOAD_MB=15

# Privacy release
DP_EPSILON_BUDGET=1.0
DP_EPSILON_PER_RELEASE=0.1
K_ANONYMITY=11
